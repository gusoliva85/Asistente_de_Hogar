# JARVIS — variables de entorno
#
# Copiá este archivo como .env EN EL SERVIDOR y completá los valores.
# El .env real NUNCA se versiona. Este archivo no debe tener ningún valor verdadero.

# ─── General ────────────────────────────────────────────────────────────────
ENTORNO=desarrollo                    # desarrollo | pruebas | produccion
ZONA_HORARIA=America/Argentina/Buenos_Aires
DOMINIO=                              # ej: jarvis.midominio.com — vacío = usar IP
EMAIL_CERTIFICADO=                    # para los avisos de Let's Encrypt

# ─── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_USUARIO=jarvis
POSTGRES_PASSWORD=                    # generá una larga y aleatoria
POSTGRES_DB=jarvis
DATABASE_URL=postgresql+asyncpg://jarvis:CAMBIAR@db:5432/jarvis

# ─── Autenticación ──────────────────────────────────────────────────────────
JWT_SECRET=                           # 64 caracteres aleatorios
JWT_MINUTOS_EXPIRACION=30
JWT_DIAS_REFRESCO=30

# ─── Modelo de lenguaje ─────────────────────────────────────────────────────
# Nivel 2: modelo local (Fase 5)
MODELO_LOCAL_URL=http://llm:8080
MODELO_LOCAL_NOMBRE=
# Nivel 3: proveedor remoto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LIMITE_GASTO_MENSUAL_USD=5

# ─── Voz ────────────────────────────────────────────────────────────────────
STT_URL=http://stt:8001
STT_MODELO=small

# ─── Servicios externos ─────────────────────────────────────────────────────
CLIMA_API_KEY=
CLIMA_LATITUD=
CLIMA_LONGITUD=
VIAJE_API_KEY=
VIAJE_DESTINO=

# ─── Notificaciones (Fase 6) ────────────────────────────────────────────────
VAPID_CLAVE_PUBLICA=
VAPID_CLAVE_PRIVADA=
VAPID_CONTACTO=

# ─── Emergencias (Fase 7) ───────────────────────────────────────────────────
SMS_PROVEEDOR=
SMS_API_KEY=
SMS_REMITENTE=
TELEFONIA_PROVEEDOR=
TELEFONIA_API_KEY=

# ─── Domótica (Fase 9) ──────────────────────────────────────────────────────
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=us

# ─── Música (Fase 8) ────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
