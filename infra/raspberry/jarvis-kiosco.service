# JARVIS — kiosco
#
# Arranca cage (un compositor Wayland mínimo) con Chromium adentro.
# Se eligió cage y no un escritorio completo porque la Pi 3 tiene 1 GB
# de RAM y cage no trae barra de tareas, ni fondo, ni gestor de
# archivos: solo muestra una ventana a pantalla completa.
#
# Instalar en /etc/systemd/system/jarvis-kiosco.service

[Unit]
Description=JARVIS en modo kiosco
# Sin red no hay pantalla que mostrar, pero tampoco se queda esperando
# para siempre: si la red tarda, igual arranca y el frontend muestra
# su propio estado de "sin conexión".
Wants=network-online.target
After=network-online.target systemd-user-sessions.service

[Service]
Type=simple
User=jarvis_gus
PAMName=login
TTYPath=/dev/tty1
Environment=XDG_RUNTIME_DIR=/run/user/1000
# ?vidrio=solido apaga el desenfoque del vidrio y nada más. En la Pi 3,
# backdrop-filter tumba el renderizador de Chromium con una violación de
# segmento —"Aw Snap, error code 11"— y no es falta de memoria: el dmesg
# sale limpio. Las animaciones, el grano y las sombras siguen encendidos.
Environment=JARVIS_URL=http://13.140.36.93/?vidrio=solido
ExecStart=/usr/bin/cage -d -- /usr/local/bin/iniciar-kiosco.sh

# Si Chromium se cae, vuelve. Es un dispositivo sin teclado: nadie va a
# ir a reiniciarlo a mano.
Restart=always
RestartSec=3

# No va MemoryMax acá: con PAMName=login la sesión se mueve al ámbito
# del usuario y el límite del servicio no alcanza a los procesos. Se
# comprueba con `systemctl show jarvis-kiosco -p MemoryCurrent`: si
# devuelve "[not set]", no está midiendo nada y el límite es decorativo.
# Pendiente de resolver bien; mientras tanto, el consumo se vigila a
# mano (F1.10).

[Install]
WantedBy=multi-user.target
