# Sin bloque global de opciones a propósito.
# La directiva "email" no admite valor vacío: si EMAIL_CERTIFICADO no está
# definido, Caddy no arranca. Let's Encrypt no exige correo, así que se
# omite. Cuando haya dominio y quieras avisos de vencimiento, agregá
# dentro del bloque del sitio:  tls tu@correo.com

{$DOMINIO} {
	encode gzip zstd

	# API
	handle /api/* {
		reverse_proxy api:8000
	}

	# Salud, para monitoreo
	handle /health {
		reverse_proxy api:8000
	}

	# Los archivos con huella en el nombre —index-CP59w0GO.js— nunca
	# cambian de contenido: si cambian, cambia el nombre. Se pueden
	# guardar un año y evitan que la Raspberry vuelva a pedirlos en
	# cada arranque del kiosco.
	@conHuella path_regexp /assets/.*-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpg|svg)$
	header @conHuella Cache-Control "public, max-age=31536000, immutable"

	# index.html es la excepción: no lleva huella, y si se cachea, la
	# Pi se queda con una versión vieja que apunta a archivos que ya
	# no existen y muestra una pantalla en blanco.
	@entrada path / /index.html
	header @entrada Cache-Control "no-cache"

	# Frontend
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/acceso.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
